  "productId": "0x8071",
  "matrix": {
    "rows": 5,
    "cols": 16
  },
  "keycodes": [
    "qmk_lighting"
  ],
  "menus": [
    "qmk_rgb_matrix",
    {
      "label": "Side lights",
      "content": [
        {
          "label": "Side lights",
          "content": [
            {
              "label": "Colour",
              "type": "dropdown",
              "options": [
                "Follow keyboard",
                "Fixed colour",
                "Off"
              ],
              "content": [
                "id_side_mode",
                0,
                1
              ]
            },
            {
              "showIf": "{id_side_mode} == 1",
              "label": "Fixed colour",
              "type": "color",
              "content": [
                "id_side_colour",
                0,
                2
              ]
            },
            {
              "showIf": "{id_side_mode} != 2",
              "label": "Effect",
              "type": "dropdown",
              "options": [
                "Static",
                "Breathing",
                "Colour cycle",
                "Type pulse",
                "Wave"
              ],
              "content": [
                "id_side_effect",
                0,
                17
              ]
            },
            {
              "showIf": "{id_side_mode} != 2 && {id_side_effect} != 0",
              "label": "Effect speed",
              "type": "range",
              "options": [
                0,
                31
              ],
              "content": [
                "id_side_fx_speed",
                0,
                18
              ]
            },
            {
              "label": "Brightness",
              "type": "range",
              "options": [
                0,
                31
              ],
              "content": [
                "id_side_bright",
                0,
                8
              ]
            },
            {
              "label": "Brightness follows the keyboard",
              "type": "toggle",
              "content": [
                "id_side_follow_brightness",
                0,
                9
              ]
            },
            {
              "label": "Experimental: light one position at a time",
              "type": "toggle",
              "content": [
                "id_side_scan",
                0,
                27
              ]
            },
            {
              "label": "Red",
              "type": "range",
              "options": [
                0,
                31
              ],
              "content": [
                "id_side_red",
                0,
                5
              ]
            },
            {
              "label": "Green",
              "type": "range",
              "options": [
                0,
                31
              ],
              "content": [
                "id_side_green",
                0,
                6
              ]
            },
            {
              "label": "Blue",
              "type": "range",
              "options": [
                0,
                31
              ],
              "content": [
                "id_side_blue",
                0,
                7
              ]
            },
            {
              "label": "Show status (pairing, mode, battery)",
              "type": "toggle",
              "content": [
                "id_side_status",
                0,
                3
              ]
            },
            {
              "showIf": "{id_side_status} == 1",
              "label": "Status brightness",
              "type": "range",
              "options": [
                0,
                31
              ],
              "content": [
                "id_status_bright",
                0,
                10
              ]
            },
            {
              "showIf": "{id_side_status} == 1",
