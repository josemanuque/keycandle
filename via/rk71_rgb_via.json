              "type": "color",
              "content": [
                "id_status_wired_colour",
                0,
                19
              ]
            },
            {
              "showIf": "{id_side_status} == 1",
              "label": "Status colour: Bluetooth",
              "type": "color",
              "content": [
                "id_status_bt_colour",
                0,
                20
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Indicators",
      "content": [
        {
          "label": "Indicators",
          "content": [
            {
              "label": "Caps Lock on the nearest side light",
              "type": "toggle",
              "content": [
                "id_caps_on_side",
